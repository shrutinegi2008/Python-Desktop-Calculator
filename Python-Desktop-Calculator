
import tkinter as tk
import ast
import operator

# Safe mathematical operations
operations = {
    ast.Add: operator.add,
    ast.Sub: operator.sub,
    ast.Mult: operator.mul,
    ast.Div: operator.truediv,
    ast.USub: operator.neg,
    ast.UAdd: operator.pos
}


def calculate_expression(node):
    if isinstance(node, ast.Constant) and type(node.value) in (int, float):
        return node.value

    if isinstance(node, ast.BinOp) and type(node.op) in operations:
        left = calculate_expression(node.left)
        right = calculate_expression(node.right)
        return operations[type(node.op)](left, right)

    if isinstance(node, ast.UnaryOp) and type(node.op) in operations:
        return operations[type(node.op)](
            calculate_expression(node.operand)
        )

    raise ValueError("Invalid calculation")


# Main window
root = tk.Tk()
root.title("Professional Calculator")
root.geometry("360x520")
root.resizable(False, False)
root.configure(bg="#171923")

expression = tk.StringVar()
result_shown = False


# Display
display = tk.Entry(
    root,
    textvariable=expression,
    font=("Arial", 27),
    bg="#252A3A",
    fg="white",
    insertbackground="white",
    justify="right",
    bd=0
)
display.pack(fill="x", padx=18, pady=25, ipady=20)


def press(value):
    global result_shown

    current = expression.get()

    if result_shown:
        if value in "+-*/":
            result_shown = False
        else:
            current = ""
            result_shown = False

    expression.set(current + str(value))


def clear():
    global result_shown
    expression.set("")
    result_shown = False


def backspace():
    global result_shown
    expression.set(expression.get()[:-1])
    result_shown = False


def calculate():
    global result_shown

    try:
        exp = expression.get().strip()

        if not exp:
            return

        tree = ast.parse(exp, mode="eval")
        answer = calculate_expression(tree.body)

        if isinstance(answer, float) and answer.is_integer():
            answer = int(answer)

        expression.set(str(answer))
        result_shown = True

    except ZeroDivisionError:
        expression.set("Cannot divide by zero")
        result_shown = True

    except Exception:
        expression.set("Invalid calculation")
        result_shown = True


# Button layout
buttons = [
    ["C", "⌫", "/", "*"],
    ["7", "8", "9", "-"],
    ["4", "5", "6", "+"],
    ["1", "2", "3", "."],
    ["0", "(", ")", "="]
]


# Button colours
special = ["C", "⌫"]
operators = ["/", "*", "-", "+", "="]


def button_click(value):
    if value == "C":
        clear()
    elif value == "⌫":
        backspace()
    elif value == "=":
        calculate()
    else:
        press(value)


# Create button frame
button_frame = tk.Frame(root, bg="#171923")
button_frame.pack(expand=True, fill="both", padx=12, pady=10)

for r, row in enumerate(buttons):
    for c, value in enumerate(row):

        if value in special:
            color = "#E76F51"
        elif value in operators:
            color = "#7357D8"
        else:
            color = "#303649"

        btn = tk.Button(
            button_frame,
            text=value,
            font=("Arial", 18, "bold"),
            bg=color,
            fg="white",
            activebackground="#9298B0",
            activeforeground="white",
            bd=0,
            cursor="hand2",
            command=lambda v=value: button_click(v)
        )

        btn.grid(
            row=r,
            column=c,
            sticky="nsew",
            padx=5,
            pady=5
        )

# Equal-sized buttons
for i in range(5):
    button_frame.rowconfigure(i, weight=1)

for i in range(4):
    button_frame.columnconfigure(i, weight=1)


# Keyboard support
def keyboard_input(event):
    key = event.char

    if key in "0123456789+-*/.()":
        press(key)
        return "break"

    elif event.keysym == "Return":
        calculate()
        return "break"

    elif event.keysym == "BackSpace":
        backspace()
        return "break"

    elif event.keysym == "Escape":
        clear()
        return "break"


root.bind("<Key>", keyboard_input)

root.mainloop()
